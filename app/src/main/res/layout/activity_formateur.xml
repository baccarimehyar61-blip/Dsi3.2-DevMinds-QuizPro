<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFormateurTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestion des Quiz"
                android:textColor="#0B4F6C"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Liste des quiz créés pour les commerciaux"
                android:textColor="#757575"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRetourQues"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#0B4F6C"
            android:text="Retour"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ListQues"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnAjouterQues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="+ Créer un nouveau Quiz"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFF7A21B" />

</LinearLayout>