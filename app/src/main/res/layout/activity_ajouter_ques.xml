
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajouter une Question"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:gravity="center"
            android:layout_marginBottom="25dp"/>

        <EditText
            android:id="@+id/etTypeQuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type de question (QCM, Vrai/Faux...)"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etContenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contenu de la question"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etReponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Réponse correcte"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDuree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Durée en secondes"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Image (facultatif)"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDocument"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Document (facultatif)"
            android:inputType="text"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnEnregistrerQues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajouter Question"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
